---
export const prerender = false;
import { SITE } from "@/config";
import "@/index.css";

interface Props {
  title: string;
  active?: "dashboard" | "import" | "media" | "analytics";
}
const { title, active } = Astro.props;

const navItems = [
  { key: "dashboard", href: "/admin/", label: "Artigos" },
  { key: "import", href: "/admin/import/", label: "Importar JSON" },
  { key: "media", href: "/admin/media/", label: "Media" },
  { key: "analytics", href: "/admin/analytics/", label: "Analytics" },
];
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · {SITE.name}</title>
  </head>
  <body class="min-h-screen bg-[#F5F0E8] text-foreground">
    <header class="bg-azul-dark text-white sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between gap-4">
        <div class="flex items-center gap-6">
          <a href="/admin/" class="font-display font-bold text-ouro-light text-sm whitespace-nowrap">Cristiane · Admin</a>
          <nav class="hidden sm:flex items-center gap-1">
            {
              navItems.map((n) => (
                <a
                  href={n.href}
                  class:list={[
                    "px-3 py-1.5 rounded-lg text-[13px] font-medium transition-colors",
                    active === n.key ? "bg-white/15 text-white" : "text-white/55 hover:text-white hover:bg-white/10",
                  ]}
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="flex items-center gap-3">
          <a href="/" target="_blank" class="text-[13px] text-white/55 hover:text-white transition-colors">Ver site ↗</a>
          <form method="POST" action="/api/logout/">
            <button class="text-[13px] text-white/55 hover:text-white transition-colors">Sair</button>
          </form>
        </div>
      </div>
      <nav class="sm:hidden flex items-center gap-1 px-5 pb-2 overflow-x-auto">
        {
          navItems.map((n) => (
            <a
              href={n.href}
              class:list={[
                "px-3 py-1.5 rounded-lg text-[13px] font-medium whitespace-nowrap transition-colors",
                active === n.key ? "bg-white/15 text-white" : "text-white/55 hover:text-white",
              ]}
            >
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="max-w-6xl mx-auto px-5 py-8">
      <h1 class="font-display text-2xl font-bold text-azul mb-6">{title}</h1>
      <slot />
    </main>
  </body>
</html>
