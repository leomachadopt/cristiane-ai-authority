---
export const prerender = false;
import { SITE } from "@/config";
import "@/index.css";

interface Props {
  title: string;
  active?: "dashboard" | "import" | "leads" | "media" | "fotos" | "analytics";
}
const { title, active } = Astro.props;

const navItems = [
  { key: "dashboard", href: "/admin/", label: "Artigos" },
  { key: "import", href: "/admin/import/", label: "Importar JSON" },
  { key: "leads", href: "/admin/leads/", label: "Leads" },
  { key: "media", href: "/admin/media/", label: "Media" },
  { key: "fotos", href: "/admin/fotos/", label: "Fotos Site" },
  { key: "analytics", href: "/admin/analytics/", label: "Analytics" },
];

const itemCls = (k: string, base: string) =>
  active === k ? `${base} bg-white/15 text-white` : `${base} text-white/60 hover:text-white hover:bg-white/10`;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · {SITE.name}</title>
  </head>
  <body class="min-h-screen bg-[#F5F0E8] text-foreground">
    <div class="flex min-h-screen">
      <!-- Sidebar (desktop) -->
      <aside class="hidden md:flex md:flex-col md:w-60 md:shrink-0 bg-azul-dark text-white sticky top-0 h-screen">
        <div class="px-5 h-16 flex items-center border-b border-white/10">
          <a href="/admin/" class="font-display font-bold text-ouro-light">Cristiane · Admin</a>
        </div>
        <nav class="flex-1 p-3 flex flex-col gap-1 overflow-y-auto">
          {
            navItems.map((n) => (
              <a href={n.href} class={itemCls(n.key, "px-3 py-2.5 rounded-lg text-sm font-medium transition-colors")}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="p-3 border-t border-white/10 flex flex-col gap-1">
          <a href="/" target="_blank" class="px-3 py-2 rounded-lg text-[13px] text-white/60 hover:text-white hover:bg-white/10 transition-colors">Ver site ↗</a>
          <form method="POST" action="/api/logout/">
            <button class="w-full text-left px-3 py-2 rounded-lg text-[13px] text-white/60 hover:text-white hover:bg-white/10 transition-colors">Sair</button>
          </form>
        </div>
      </aside>

      <!-- Conteúdo -->
      <div class="flex-1 min-w-0 flex flex-col">
        <!-- Top bar (mobile) -->
        <header class="md:hidden bg-azul-dark text-white sticky top-0 z-40">
          <div class="px-4 h-14 flex items-center justify-between">
            <a href="/admin/" class="font-display font-bold text-ouro-light text-sm">Cristiane · Admin</a>
            <div class="flex items-center gap-3">
              <a href="/" target="_blank" class="text-[13px] text-white/60">Ver site ↗</a>
              <form method="POST" action="/api/logout/"><button class="text-[13px] text-white/60">Sair</button></form>
            </div>
          </div>
          <nav class="flex items-center gap-1 px-3 pb-2 overflow-x-auto">
            {
              navItems.map((n) => (
                <a href={n.href} class={itemCls(n.key, "px-3 py-1.5 rounded-lg text-[13px] font-medium whitespace-nowrap transition-colors")}>
                  {n.label}
                </a>
              ))
            }
          </nav>
        </header>

        <main class="flex-1 max-w-5xl w-full mx-auto px-5 md:px-8 py-8">
          <h1 class="font-display text-2xl font-bold text-azul mb-6">{title}</h1>
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
