---
// SSR (on-demand): lê a foto do site em runtime (ver index.astro).
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteImages } from "@/lib/siteImages";
import Sobre from "@/views/Sobre.tsx";

const images = await getSiteImages();
---

<BaseLayout
  title="Sobre · Quem é a Dra. Cristiane Martins"
  description="Especialista em Odontopediatria Integrativa, Ortopedia Funcional dos Maxilares e Medicina do Sono. 25 anos a ajudar famílias a ver o desenvolvimento dos filhos como um sistema."
  canonical="/sobre/"
>
  <Sobre client:load image={images.sobre} />
</BaseLayout>
