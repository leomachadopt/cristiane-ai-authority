---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getLeads } from "@/lib/leads";
import { hasDb } from "@/lib/db";

const dbReady = hasDb();
const leads = dbReady ? await getLeads() : [];

const fmt = (d: string) =>
  new Date(d).toLocaleString("pt-PT", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
---

<AdminLayout title="Leads" active="leads">
  {
    !dbReady && (
      <div class="bg-coral/10 border border-coral/30 rounded-xl px-5 py-4 mb-6 text-sm text-azul">
        <strong>Base de dados não configurada.</strong> Define <code>DATABASE_URL</code> (Neon) para recolher leads.
      </div>
    )
  }

  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <span class="text-sm text-muted-foreground">{leads.length} lead(s) recolhido(s) pelo checklist gratuito</span>
    {
      leads.length > 0 && (
        <a href="/api/leads/export/" class="bg-azul-dark hover:bg-azul text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
          ↓ Exportar CSV
        </a>
      )
    }
  </div>

  {
    leads.length === 0 ? (
      <p class="text-muted-foreground">Ainda não há leads. Aparecem aqui quando alguém submete o checklist em <code>/familias</code>.</p>
    ) : (
      <div class="bg-white rounded-2xl border border-border/60 overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead>
            <tr class="text-left text-[12px] uppercase tracking-wider text-muted-foreground border-b border-border/60">
              <th class="px-4 py-3 font-semibold">Data</th>
              <th class="px-4 py-3 font-semibold">Nome</th>
              <th class="px-4 py-3 font-semibold">Email</th>
              <th class="px-4 py-3 font-semibold">Sinais assinalados</th>
            </tr>
          </thead>
          <tbody>
            {leads.map((l) => (
              <tr class="border-b border-border/40 last:border-0 align-top hover:bg-salvia/[0.04]">
                <td class="px-4 py-3 text-muted-foreground whitespace-nowrap">{fmt(l.created_at)}</td>
                <td class="px-4 py-3 text-azul">{l.nome ?? "—"}</td>
                <td class="px-4 py-3">
                  <a href={`mailto:${l.email}`} class="text-azul underline">{l.email}</a>
                </td>
                <td class="px-4 py-3">
                  {l.respostas && l.respostas.length > 0 ? (
                    <div class="flex flex-wrap gap-1.5">
                      {l.respostas.map((r) => (
                        <span class="text-[12px] bg-ouro/15 text-[#854F0B] px-2 py-0.5 rounded-full">{r}</span>
                      ))}
                    </div>
                  ) : (
                    <span class="text-muted-foreground/60 text-[13px]">nenhum</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
