---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArticleBySlug } from "@/lib/articles";
import { pilarLabel } from "@/lib/cta";
import { renderMarkdown } from "@/lib/markdown";

const { slug } = Astro.params;
const article = slug ? await getArticleBySlug(slug) : null;
const bodyHtml = article ? renderMarkdown(article.content ?? "") : "";
const faqs = article?.faq ?? [];
---

<BaseLayout title={`Prévia · ${article?.title ?? "Artigo"}`} description="Pré-visualização" noindex={true}>
  <div class="bg-ouro text-ouro-foreground text-center text-sm font-semibold py-2 px-4">
    PRÉVIA — {article?.draft ? "rascunho não publicado" : "artigo publicado"}.
    <a href={`/admin/edit/${slug}/`} class="underline">Editar</a>
  </div>

  {
    !article ? (
      <div class="container max-w-3xl py-20"><p class="text-muted-foreground">Artigo não encontrado.</p></div>
    ) : (
      <article class="py-12 md:py-16">
        <div class="container max-w-3xl">
          <span class="text-[12px] font-semibold tracking-wider uppercase text-ouro mb-3 block">{pilarLabel(article.pilar)}</span>
          <h1 class="font-display text-3xl md:text-[42px] font-bold text-azul leading-[1.15] mb-4">{article.title}</h1>
          <div class="text-sm text-muted-foreground mb-8">{article.author}</div>

          {article.image && <img src={article.image} alt={article.cover_alt ?? article.title} class="w-full rounded-2xl mb-8" />}

          {article.resposta_direta && (
            <div class="bg-salvia/10 border-l-4 border-salvia rounded-r-xl px-6 py-5 mb-10">
              <p class="text-[12px] font-semibold tracking-wider uppercase text-salvia mb-2">Resposta rápida</p>
              <p class="text-[17px] text-azul leading-relaxed">{article.resposta_direta}</p>
            </div>
          )}

          <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-azul prose-h2:text-2xl prose-p:text-foreground/85 prose-a:text-ouro prose-strong:text-azul" set:html={bodyHtml} />

          {faqs.length > 0 && (
            <section class="mt-14">
              <h2 class="font-display text-2xl font-bold text-azul mb-6">Perguntas frequentes</h2>
              <div class="flex flex-col gap-3">
                {faqs.map((f) => (
                  <div class="bg-card rounded-xl border border-border/60 px-6 py-4">
                    <p class="font-display font-semibold text-base text-azul">{f.pergunta}</p>
                    <p class="text-sm text-muted-foreground leading-relaxed mt-2">{f.resposta}</p>
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      </article>
    )
  }
</BaseLayout>
