---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleContent from "@/components/ArticleContent.astro";
import { getArticleBySlug, resolveRelated } from "@/lib/articles";

const { slug } = Astro.params;
const article = slug ? await getArticleBySlug(slug) : null;
const related = article ? await resolveRelated(article.related ?? []) : [];
const title = article ? article.seo_title || article.title : "Artigo";
const description = article ? article.meta_description || article.description || "" : "";
---

<BaseLayout title={`Prévia · ${title}`} description={description} noindex={true}>
  <div class="bg-ouro text-ouro-foreground text-center text-sm font-semibold py-2 px-4 sticky top-0 z-[70]">
    PRÉVIA — {article?.draft ? "rascunho não publicado" : "publicado"}
    {article && <a href={`/admin/edit/${slug}/`} class="underline ml-1">Editar</a>}
  </div>

  {
    !article ? (
      <div class="container max-w-3xl py-20"><p class="text-muted-foreground">Artigo não encontrado.</p></div>
    ) : (
      <ArticleContent article={article} related={related} />
    )
  }
</BaseLayout>
