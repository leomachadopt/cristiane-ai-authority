---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import { IMAGE_SLOTS, getSiteImages } from "@/lib/siteImages";
import { hasDb } from "@/lib/db";

const dbReady = hasDb();
const images = dbReady ? await getSiteImages() : {};
const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");
const errorMsgs: Record<string, string> = {
  ficheiro: "Seleciona um ficheiro de imagem.",
  tipo: "O ficheiro tem de ser uma imagem.",
  tamanho: "Imagem demasiado grande (máx. 8 MB).",
  upload: "Falha no upload. Confirma que o Vercel Blob está ligado a este ambiente.",
  slot: "Zona inválida.",
};
---

<AdminLayout title="Fotos do Site" active="fotos">
  {
    !dbReady && (
      <div class="bg-coral/10 border border-coral/30 rounded-xl px-5 py-4 mb-6 text-sm text-azul">
        <strong>Base de dados não configurada.</strong> Define <code>DATABASE_URL</code> (Neon) para gerir as fotos.
      </div>
    )
  }
  {saved && <div class="bg-salvia/10 border border-salvia/30 rounded-xl px-4 py-3 mb-6 text-sm text-[#3C5E46]">Foto atualizada. O site reconstrói em ~1 min.</div>}
  {error && <div class="bg-destructive/10 border border-destructive/30 rounded-xl px-4 py-3 mb-6 text-sm text-destructive">{errorMsgs[error] ?? "Ocorreu um erro."}</div>}

  <p class="text-sm text-muted-foreground mb-6 max-w-2xl">
    Substitui aqui as imagens placeholder de cada zona do site. <strong>Carrega a foto</strong> do
    teu computador e escreve o texto alternativo. Ao guardar, o site é reconstruído automaticamente.
  </p>

  <div class="grid sm:grid-cols-2 gap-5">
    {
      IMAGE_SLOTS.map((slot) => {
        const current = images[slot.key];
        return (
          <div class="bg-white rounded-2xl border border-border/60 p-5">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <h3 class="font-display font-bold text-azul">{slot.label}</h3>
                <p class="text-[13px] text-muted-foreground">{slot.area} · proporção {slot.aspect}</p>
              </div>
              <span class:list={["text-[12px] font-semibold px-2.5 py-0.5 rounded-full shrink-0", current ? "bg-salvia/20 text-[#3C5E46]" : "bg-ouro/15 text-[#854F0B]"]}>
                {current ? "Definida" : "Placeholder"}
              </span>
            </div>

            <p class="text-[13px] text-muted-foreground mb-3">{slot.description}</p>

            <div class="rounded-xl overflow-hidden bg-salvia/10 border border-border mb-3" style={`aspect-ratio:${slot.aspect}`}>
              {current ? (
                <img src={current.url} alt={current.alt} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-[13px] text-muted-foreground/70 px-4 text-center">Sem imagem — placeholder ativo</div>
              )}
            </div>

            <form method="POST" action="/api/site-images/upload/" enctype="multipart/form-data" class="flex flex-col gap-2">
              <input type="hidden" name="slot" value={slot.key} />
              <input
                name="file"
                type="file"
                accept="image/*"
                required
                class="text-[13px] text-muted-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-azul-dark file:text-white file:text-[13px] file:font-semibold file:cursor-pointer"
              />
              <input
                name="alt"
                type="text"
                placeholder="Texto alternativo (acessibilidade/SEO)"
                value={current?.alt ?? ""}
                class="px-3 py-2 rounded-lg border-[1.5px] border-border bg-white text-[13px] outline-none focus:border-ouro"
              />
              <button class="bg-azul-dark hover:bg-azul text-white px-4 py-2 rounded-lg text-[13px] font-semibold transition-colors self-start">
                Carregar foto
              </button>
            </form>
            {current && (
              <form method="POST" action="/api/site-images/update/" class="mt-2">
                <input type="hidden" name="slot" value={slot.key} />
                <input type="hidden" name="action" value="remove" />
                <button class="text-[13px] text-destructive hover:bg-destructive/10 px-3 py-1.5 rounded-lg transition-colors" onclick="return confirm('Repor o placeholder nesta zona?')">Remover foto atual</button>
              </form>
            )}
          </div>
        );
      })
    }
  </div>
</AdminLayout>
