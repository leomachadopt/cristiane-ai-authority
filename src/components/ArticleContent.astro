---
/**
 * Corpo visível de um artigo — partilhado pela página pública (/blog/[slug])
 * e pela pré-visualização do admin. Garante que o preview == render real.
 */
import { getCta, pilarLabel } from "@/lib/cta";
import { renderMarkdown } from "@/lib/markdown";
import type { DbArticle } from "@/lib/articles";

interface Props {
  article: DbArticle;
  related?: { href: string; label: string }[];
}
const { article, related = [] } = Astro.props;

const bodyHtml = renderMarkdown(article.content ?? "");
const cta = getCta(article.cta);
const refs = article.referencias ?? [];
const faqs = article.faq ?? [];
const aVerificar = refs.some((r) => r.estado_verificacao === "a-verificar");
const fmtDate = (d: string | null) =>
  d ? new Date(d).toLocaleDateString("pt-PT", { day: "2-digit", month: "long", year: "numeric" }) : "";
---

<!-- Hero imersivo do artigo (imagem de capa + overlay petróleo + título sobreposto) -->
<header class="relative bg-petroleo overflow-hidden">
  {
    article.image && (
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image:url('${article.image}')`}
        aria-hidden="true"
      />
    )
  }
  <div
    class="absolute inset-0"
    style="background:linear-gradient(170deg, rgba(28,64,75,0.74) 0%, rgba(28,64,75,0.90) 70%, rgba(28,64,75,0.95) 100%)"
    aria-hidden="true"
  />
  <div class="relative container max-w-3xl py-16 md:py-24">
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm text-white/80 hover:text-white transition-colors mb-6">
      ← Blog
    </a>
    <span class="block text-[12px] font-semibold tracking-[0.18em] uppercase text-ouro-light mb-4">{pilarLabel(article.pilar)}</span>
    <h1 class="font-display text-4xl sm:text-5xl md:text-[56px] font-bold text-white leading-[1.08] mb-5">{article.title}</h1>
    <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-white/75">
      <span class="font-medium text-white">Por {article.author}</span>
      {article.pub_date && <><span class="text-white/40">·</span><time datetime={article.pub_date}>{fmtDate(article.pub_date)}</time></>}
    </p>
  </div>
</header>

<article class="py-12 md:py-16">
  <div class="container max-w-3xl">
    {article.cover_caption && (
      <p class="text-[13px] text-muted-foreground/70 italic mb-6">{article.cover_caption}</p>
    )}

    {
      article.resposta_direta && (
        <div class="bg-petroleo/[0.07] border-l-4 border-petroleo rounded-r-xl px-6 py-5 mb-10">
          <p class="text-[13px] font-semibold tracking-wider uppercase text-petroleo mb-2">Resposta rápida</p>
          <p class="text-[17px] text-azul leading-relaxed">{article.resposta_direta}</p>
        </div>
      )
    }

    <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-azul prose-headings:font-bold prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:text-foreground/85 prose-p:leading-relaxed prose-a:text-ouro prose-a:font-medium prose-strong:text-azul prose-li:text-foreground/85" set:html={bodyHtml} />

    {
      faqs.length > 0 && (
        <section class="mt-14">
          <h2 class="font-display text-2xl font-bold text-azul mb-6">Perguntas frequentes</h2>
          <div class="flex flex-col gap-3">
            {faqs.map((f) => (
              <details class="bg-card rounded-xl border border-border/60 px-6 py-4 group">
                <summary class="font-display font-semibold text-base text-azul cursor-pointer list-none flex justify-between items-center gap-4">
                  {f.pergunta}
                  <span class="text-ouro transition-transform group-open:rotate-45 text-xl leading-none">+</span>
                </summary>
                <p class="text-sm text-muted-foreground leading-relaxed mt-3">{f.resposta}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      refs.length > 0 && (
        <section class="mt-14">
          <h2 class="font-display text-xl font-bold text-azul mb-4">Referências</h2>
          {aVerificar && <p class="text-[13px] text-coral mb-3">⚠ Algumas referências estão a aguardar verificação.</p>}
          <ol class="list-decimal pl-5 flex flex-col gap-2 text-[13px] text-muted-foreground leading-relaxed">
            {refs.map((r) => (
              <li>
                {r.citacao}
                {r.pmid && <> · <a class="text-ouro" href={`https://pubmed.ncbi.nlm.nih.gov/${r.pmid}/`} target="_blank" rel="noopener">PMID {r.pmid}</a></>}
                {r.doi && <> · <a class="text-ouro" href={`https://doi.org/${r.doi}`} target="_blank" rel="noopener">DOI</a></>}
                {r.estado_verificacao === "a-verificar" && <span class="text-coral"> (a verificar)</span>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-14">
          <h2 class="font-display text-xl font-bold text-azul mb-4">Continua a ler</h2>
          <div class="flex flex-col gap-2.5">
            {related.map((r) => (
              <a href={r.href} class="flex items-center gap-2 text-[15px] text-azul hover:text-ouro transition-colors group">
                <span class="text-ouro">→</span>
                <span class="group-hover:underline">{r.label}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</article>

<section class="py-16 md:py-20 px-6 text-center bg-[linear-gradient(135deg,#2C5F6F_0%,#244E5A_100%)]">
  <div class="container max-w-2xl">
    <span class="inline-block bg-ouro/12 border border-ouro/20 text-ouro-light text-[12px] font-semibold tracking-[0.18em] uppercase px-4 py-1.5 rounded-full mb-5">{cta.eyebrow}</span>
    <h2 class="font-display text-3xl md:text-4xl font-bold text-white leading-[1.15] mb-4">{cta.title}</h2>
    <p class="text-[17px] text-white/75 leading-relaxed max-w-lg mx-auto mb-8">{cta.text}</p>
    <a
      href={cta.href}
      {...(cta.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      class="inline-flex items-center gap-2 bg-coral hover:bg-coral text-white active:scale-[0.97] px-8 py-4 rounded-full text-base font-semibold transition-[transform,background-color] ease-out-expo hover:-translate-y-0.5"
    >
      {cta.button}
    </a>
  </div>
</section>
