---
import { NAV } from "@/config";
import {
  WHATSAPP_LINK,
  PHONE_LINK,
  PHONE_DISPLAY,
  LOCATION,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  CLINIC_INSTAGRAM,
} from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="bg-[#0C1E24] text-white pt-14 pb-7 px-6">
  <div class="container max-w-5xl">
    <div class="grid grid-cols-1 md:grid-cols-[1.6fr_1fr_1fr] gap-10 md:gap-12 mb-10">
      <div>
        <h3 class="font-display font-semibold text-lg text-white">Dra. Cristiane Martins</h3>
        <p class="text-[13px] text-white/55 tracking-wide mb-4">Odontopediatria · Ortopedia Funcional dos Maxilares</p>
        <p class="text-sm text-white/60 leading-relaxed max-w-xs">
          Especialista em Odontopediatria Integrativa, Ortopedia Funcional dos Maxilares e Medicina
          do Sono. Criadora da Metodologia Respira e Cresce 360.
        </p>
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 hover:bg-white/10 transition"
        >
          <svg class="w-4 h-4 text-salvia" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          <span class="text-sm text-white">{INSTAGRAM_HANDLE}</span>
        </a>
      </div>

      <div>
        <h4 class="eyebrow mb-4">Navegação</h4>
        <div class="flex flex-col gap-2">
          {
            NAV.map((link) => (
              <a href={link.href} class="text-sm text-white/60 hover:text-white transition-colors">
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h4 class="eyebrow mb-4">Contactos</h4>
        <div class="flex flex-col gap-2.5">
          <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="text-sm text-white/60 hover:text-white transition-colors">
            WhatsApp — escreve RESPIRA
          </a>
          <a href={PHONE_LINK} class="text-sm text-white/60 hover:text-white transition-colors">{PHONE_DISPLAY}</a>
          <span class="text-sm text-white/60">{LOCATION}</span>
        </div>
        <div class="mt-4 bg-white/[0.03] border border-white/10 rounded-xl px-4 py-2.5">
          <p class="text-[13px] text-salvia font-semibold">Clínica</p>
          <p class="text-sm text-white">{CLINIC_INSTAGRAM}</p>
        </div>
      </div>
    </div>

    <!-- Barra legal (informação obrigatória — Portugal) -->
    <div class="border-t border-white/10 pt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between text-[13px] text-white/50">
      <p>
        © {year} Dra. Cristiane Martins · Registo ERS n.º 20788 · N.º Reg. Estab. na ERS E175646
      </p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <nav aria-label="Legal" class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="https://cristianemartins.pt/politica-de-privacidade/" class="hover:text-white transition-colors">Política de Privacidade</a>
          <a href="https://cristianemartins.pt/termos-e-condicoes/" class="hover:text-white transition-colors">Termos e Condições</a>
          <a href="https://cristianemartins.pt/resolucao-alternativa-de-litigios/" class="hover:text-white transition-colors">Resolução Alternativa de Litígios</a>
        </nav>
        <a
          href="https://www.livroreclamacoes.pt/Inicio/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Livro de Reclamações (abre em nova janela)"
          class="shrink-0 opacity-90 transition-opacity hover:opacity-100"
        >
          <img src="/livro-reclamacoes.png" alt="Livro de Reclamações" width="500" height="207" class="h-9 w-auto" />
        </a>
      </div>
    </div>
  </div>
</footer>
