---
import { NAV, BUSINESS } from "@/config";
import { LOCATION } from "@/lib/site";
import MobileMenu from "@/components/MobileMenu.tsx";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!-- Barra de urgência -->
<div class="bg-azul text-white text-sm py-2.5 px-4 flex items-center justify-center gap-2 text-center">
  <svg class="w-4 h-4 text-ouro-light shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.8 19.6A2 2 0 1 0 14 16H2"/><path d="M17.5 8a2.5 2.5 0 1 1 2 4H2"/><path d="M9.8 4.4A2 2 0 1 1 11 8H2"/></svg>
  <span class="text-white/80">
    Consulta <strong class="text-ouro-light font-semibold">Respira e Cresce 360</strong> disponível em {LOCATION}
  </span>
  <a href="/contacto/" class="hidden sm:inline text-ouro-light font-semibold border-b border-ouro/40 hover:opacity-80 transition">
    Ver como funciona →
  </a>
</div>

<header
  id="site-header"
  class="sticky top-0 left-0 right-0 z-50 glass transition-[box-shadow] duration-200 ease-out-expo"
>
  <nav class="container flex items-center justify-between h-16 md:h-[68px]">
    <a href="/" class="leading-tight">
      <span class="block font-display text-base md:text-lg font-semibold text-azul">Dra. Cristiane Martins</span>
      <span class="block text-[13px] md:text-[13px] text-muted-foreground tracking-wide">
        Odontopediatria Integrativa · RC360
      </span>
    </a>

    <!-- Desktop nav (HTML estático) -->
    <div class="hidden lg:flex items-center gap-6">
      {
        NAV.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium tracking-wide transition-colors",
              isActive(link.href) ? "text-azul" : "text-muted-foreground hover:text-azul",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contacto/"
        class="bg-ouro hover:bg-ouro-light text-ouro-foreground active:scale-[0.97] px-5 py-2.5 rounded-lg text-sm font-semibold transition-[transform,background-color,border-color,box-shadow,color,opacity] ease-out-expo hover:-translate-y-0.5"
      >
        Marcar Consulta
      </a>
    </div>

    <!-- Mobile (island) -->
    <MobileMenu client:idle nav={[...NAV]} pathname={pathname} />
  </nav>
</header>

<script is:inline>
  // Sombra do header ao fazer scroll (progressive enhancement).
  (function () {
    const h = document.getElementById("site-header");
    if (!h) return;
    const onScroll = () => h.classList.toggle("shadow-[0_2px_20px_rgba(0,0,0,0.08)]", window.scrollY > 80);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
