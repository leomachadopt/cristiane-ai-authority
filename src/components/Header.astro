---
import { NAV } from "@/config";
import MobileMenu from "@/components/MobileMenu.tsx";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!-- Faixa de credibilidade -->
<div class="bg-petroleo text-white text-[13px] sm:text-sm py-2.5 px-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center">
  <span><strong class="font-semibold text-ouro-light">25 anos</strong> de experiência</span>
  <span class="text-white/40" aria-hidden="true">·</span>
  <span>Médica dentista · Odontopediatria</span>
  <span class="hidden sm:inline text-white/40" aria-hidden="true">·</span>
  <span class="hidden sm:inline">Ortopedia Funcional dos Maxilares</span>
  <span class="text-white/40" aria-hidden="true">·</span>
  <span>Baseado em evidência</span>
</div>

<header
  id="site-header"
  class="sticky top-0 left-0 right-0 z-50 transition-[background-color,box-shadow,border-color] duration-300 ease-out-expo"
>
  <nav class="container flex items-center justify-between h-16 md:h-[68px]">
    <a href="/" class="leading-tight">
      <span class="block font-display text-base md:text-lg font-semibold text-petroleo">Dra. Cristiane Martins</span>
      <span class="block text-[13px] md:text-[13px] text-muted-foreground tracking-wide">
        Odontopediatria · Ortopedia Funcional
      </span>
    </a>

    <!-- Desktop nav (HTML estático) -->
    <div class="hidden lg:flex items-center gap-6">
      {
        NAV.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium tracking-wide transition-colors",
              isActive(link.href) ? "text-petroleo" : "text-foreground/70 hover:text-petroleo",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/metodologia/"
        class="bg-coral hover:bg-coral text-white active:scale-[0.97] px-5 py-2.5 rounded-full text-sm font-semibold shadow-[0_6px_18px_hsl(var(--coral)/0.3)] transition-[transform,box-shadow] ease-out-expo hover:-translate-y-0.5"
      >
        Conhecer a metodologia
      </a>
    </div>

    <!-- Mobile (island) -->
    <MobileMenu client:idle nav={[...NAV]} pathname={pathname} />
  </nav>
</header>

<script is:inline>
  // Sombra do header ao fazer scroll (progressive enhancement).
  (function () {
    const h = document.getElementById("site-header");
    if (!h) return;
    const onScroll = () => h.classList.toggle("is-scrolled", window.scrollY > 80);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
